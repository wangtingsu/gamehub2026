# GameHub 前端生产环境配置
# 复制此文件为 .env.production 并修改值

# API配置
VITE_API_BASE_URL=https://api.gamehub.com/api/v1
VITE_USE_MOCK=false
VITE_APP_NAME=GameHub
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=游戏社区平台

# 生产环境优化
VITE_DEBUG=false
VITE_LOG_LEVEL=warn
VITE_LOG_PERFORMANCE=false
VITE_API_MONITORING_ENABLED=true
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_PREFETCH=true

# Sentry 监控配置
VITE_SENTRY_ENABLED=true
VITE_SENTRY_DSN=your_production_sentry_dsn_here
VITE_APP_ENV=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# 功能开关
VITE_ENABLE_ANALYTICS=true
VITE_ANALYTICS_ID=UA-XXXXXXXXX-X
VITE_ENABLE_PWA=true
VITE_PWA_NAME=GameHub
VITE_PWA_SHORT_NAME=GameHub
VITE_PWA_THEME_COLOR=#1890ff
VITE_PWA_BACKGROUND_COLOR=#ffffff

# 图片/CDN配置
VITE_IMAGE_BASE_URL=https://cdn.gamehub.com
VITE_IMAGE_OPTIMIZATION=true
VITE_IMAGE_QUALITY=85
VITE_IMAGE_FORMAT=webp

# 认证配置
VITE_AUTH_ENABLED=true
VITE_AUTH_REDIRECT_URI=https://gamehub.com/auth/callback
VITE_AUTH_SILENT_REDIRECT_URI=https://gamehub.com/auth/silent-callback

# 第三方服务
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_FACEBOOK_APP_ID=your_facebook_app_id

# 性能配置
VITE_CHUNK_SIZE_WARNING_LIMIT=1000
VITE_ENABLE_LAZY_LOADING=true
VITE_PREFETCH_STRATEGY=viewport

# 开发工具（生产环境禁用）
VITE_ENABLE_DEVTOOLS=false
VITE_ENABLE_VUE_DEVTOOLS=false
VITE_ENABLE_REDUX_DEVTOOLS=false

# 缓存配置
VITE_CACHE_VERSION=1.0.0
VITE_ENABLE_CACHE=true
VITE_CACHE_MAX_AGE=31536000

# 安全配置
VITE_CSP_ENABLED=true
VITE_HSTS_ENABLED=true
VITE_XSS_PROTECTION_ENABLED=true