# ============================
# GameHub 生产环境配置
# 复制为 .env 并根据实际情况修改
# ============================

# 数据库
DB_USER=gamehub
DB_PASSWORD=请替换为强密码
DB_NAME=gamehub

# Redis
REDIS_PASSWORD=请替换为强密码

# JWT密钥（必须修改！）
JWT_SECRET=请替换为64位随机字符串
JWT_REFRESH_SECRET=请替换为另一个64位随机字符串

# 域名
CORS_ORIGIN=https://www.gghubs.com

# Sentry 监控（可选）
SENTRY_DSN=

# DeepSeek AI API密钥
DEEPSEEK_API_KEY=请替换为你的DeepSeek API密钥

# 管理员账号（管理后台）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为强密码

# Grafana 管理密码（使用 monitoring 覆盖时）
GRAFANA_PASSWORD=请替换为强密码
