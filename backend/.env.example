# 服务器配置
NODE_ENV=development
PORT=3000
HOST=localhost
API_PREFIX=/api/v1

# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/gamehub
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gamehub
DB_USER=postgres
DB_PASSWORD=password

# Redis配置
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# ISR配置
ENABLE_ISR=true
ISR_FRESH_TTL=300
ISR_STALE_MULTIPLIER=2
ISR_ENABLE_STALE_WHILE_REVALIDATE=true
ISR_BACKGROUND_REVALIDATION=true
ISR_MAX_CONCURRENT_REVALIDATIONS=5
ISR_FRESH_TTL_STATIC=3600
ISR_FRESH_TTL_DYNAMIC=300
ISR_FRESH_TTL_DETAIL=60
ISR_FRESH_TTL_USER=30
ISR_STALE_TTL_STATIC=7200
ISR_STALE_TTL_DYNAMIC=600
ISR_STALE_TTL_DETAIL=300
ISR_STALE_TTL_USER=60

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d

# 邮箱验证
ENABLE_EMAIL_VERIFICATION=true

# 邮件配置
EMAIL_TEST_MODE=false
EMAIL_CAPTURE_TO_FILE=false
EMAIL_CAPTURE_FILE_PATH=./logs/emails.log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@gamehub.com
EMAIL_FROM_NAME=GameHub
EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_CONCURRENCY=5
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY=5000

# 文件上传配置
UPLOAD_MAX_SIZE=20971520 # 20MB
UPLOAD_PATH=./uploads
UPLOAD_TEMP_PATH=./uploads/temp
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,image/svg+xml,image/bmp,image/tiff,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,text/csv,application/zip,application/x-rar-compressed,application/x-7z-compressed
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_QUALITY=85
CDN_ENABLED=false
CDN_BASE_URL=
CDN_PROVIDER=local
UPLOAD_CHECK_MIME=true
UPLOAD_CHECK_SIZE=true
UPLOAD_VIRUS_SCAN=false

# 安全配置
CORS_ORIGIN=http://localhost:5174
RATE_LIMIT_WINDOW_MS=900000 # 15分钟
RATE_LIMIT_MAX_REQUESTS=100

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# 短信服务配置（腾讯云 SMS）
# SMS_PROVIDER=mock       # mock | tencent | aliyun | twilio
# SMS_TEST_MODE=true        # true=只打印不发送，false=真实发送
# TENCENT_SECRET_ID=your_tencent_secret_id
# TENCENT_SECRET_KEY=your_tencent_secret_key
# SMS_SDK_APP_ID=1401146630    # 腾讯云短信应用 ID
# SMS_TEMPLATE_ID=xxxxx       # 短信模板 ID（需审核通过，参数为 {code}）
# SMS_SIGN_NAME=GameHub       # 短信签名（需审核通过）
# TENCENT_SMS_REGION=ap-guangzhou  # 地域

# API密钥
STEAM_API_KEY=your-steam-api-key
RAWG_API_KEY=your-rawg-api-key

# Sentry监控配置
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_DEBUG=false