# 生产环境配置
# 复制此文件为 .env.production 并修改值

# 服务器配置
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1

# 数据库配置 - PostgreSQL 生产环境
DATABASE_URL=postgresql://username:password@postgres-host:5432/gamehub_production
DB_HOST=postgres-host
DB_PORT=5432
DB_NAME=gamehub_production
DB_USER=production_user
DB_PASSWORD=strong_production_password_change_me

# Redis配置 - 生产环境
REDIS_URL=redis://redis-host:6379
REDIS_HOST=redis-host
REDIS_PORT=6379
REDIS_PASSWORD=strong_redis_password_change_me

# JWT配置 - 生产环境必须使用强密钥
JWT_SECRET=very_strong_jwt_secret_change_me_with_32+_chars
JWT_EXPIRES_IN=1h  # 生产环境缩短令牌有效期
JWT_REFRESH_SECRET=very_strong_refresh_secret_change_me
JWT_REFRESH_EXPIRES_IN=7d

# 邮件配置 - 生产SMTP服务
SMTP_HOST=smtp.mailservice.com
SMTP_PORT=587
SMTP_USER=production@gamehub.com
SMTP_PASSWORD=strong_smtp_password
EMAIL_FROM=noreply@gamehub.com

# 文件上传配置 - 生产环境优化
UPLOAD_MAX_SIZE=52428800  # 50MB
UPLOAD_PATH=/var/uploads/gamehub
UPLOAD_TEMP_PATH=/tmp/gamehub_uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_QUALITY=85
CDN_ENABLED=true
CDN_BASE_URL=https://cdn.gamehub.com
CDN_PROVIDER=aws  # 或 cloudinary, imgix 等
UPLOAD_CHECK_MIME=true
UPLOAD_CHECK_SIZE=true
UPLOAD_VIRUS_SCAN=true  # 生产环境启用病毒扫描

# 安全配置 - 生产环境加强
CORS_ORIGIN=https://gamehub.com,https://www.gamehub.com
RATE_LIMIT_WINDOW_MS=900000  # 15分钟
RATE_LIMIT_MAX_REQUESTS=100

# 日志配置 - 生产环境
LOG_LEVEL=info
LOG_FILE=/var/log/gamehub/app.log
LOG_FORMAT=json  # JSON格式便于日志收集
LOG_ROTATION=true
LOG_MAX_SIZE=104857600  # 100MB
LOG_MAX_FILES=10

# 短信服务配置 - 生产环境（腾讯云 SMS）
SMS_PROVIDER=tencent
SMS_TEST_MODE=false
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
SMS_SDK_APP_ID=1401146630
SMS_TEMPLATE_ID=xxxxx
SMS_SIGN_NAME=GameHub
TENCENT_SMS_REGION=ap-guangzhou

# API密钥 - 生产环境
STEAM_API_KEY=your_production_steam_api_key
RAWG_API_KEY=your_production_rawg_api_key

# 功能开关 - 生产环境
ENABLE_CACHING=true
ENABLE_COMPRESSION=true
ENABLE_HTTPS_REDIRECT=true

# Sentry监控配置 - 生产环境
SENTRY_DSN=your_production_sentry_dsn
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1  # 生产环境降低采样率
SENTRY_DEBUG=false

# 性能配置
MAX_REQUEST_SIZE=10mb
BODY_PARSER_LIMIT=10mb
QUERY_PARSER_DEPTH=10

# 会话配置
SESSION_SECRET=strong_session_secret_change_me
SESSION_MAX_AGE=86400000  # 24小时
SESSION_SECURE=true  # 生产环境只使用HTTPS
SESSION_HTTP_ONLY=true

# 数据库连接池配置
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000
DB_POOL_EVICT=10000

# Redis连接池
REDIS_POOL_MAX=10
REDIS_POOL_MIN=2