{
  "name": "gamehub-backend",
  "version": "1.0.0",
  "description": "GameHub游戏社区平台后端API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:admin": "tsx watch src/admin-index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:admin": "node dist/admin-index.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "db:migrate": "node dist/db/migrate.js",
    "db:seed": "node dist/db/seed.js",
    "migrate:up": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "migrate:status": "tsx scripts/migrate.ts status",
    "load-test": "k6 run ../scripts/load-test/basic.js",
    "benchmark": "node ../scripts/benchmark.js"
  },
  "keywords": [
    "game",
    "community",
    "api",
    "typescript",
    "nodejs"
  ],
  "author": "GameHub Team",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^10.49.0",
    "@types/ioredis": "^4.28.10",
    "@types/sqlite3": "^3.1.11",
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "global-agent": "^4.1.3",
    "helmet": "^7.0.0",
    "https-proxy-agent": "7.0.6",
    "ioredis": "^5.10.1",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.1",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-facebook": "^3.0.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-oauth2": "^1.8.0",
    "pg": "^8.10.0",
    "prom-client": "^15.1.3",
    "redis": "^4.6.5",
    "socket.io": "^4.6.1",
    "sqlite3": "^6.0.1",
    "swagger-ui-express": "^4.6.3",
    "tencentcloud-sdk-nodejs": "^4.1.252",
    "winston": "^3.8.2",
    "yaml": "^2.2.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.7",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-oauth2": "^1.8.0",
    "@types/pg": "^8.6.6",
    "@types/redis": "^4.0.11",
    "@types/supertest": "^2.0.12",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^5.60.1",
    "@typescript-eslint/parser": "^5.60.1",
    "eslint": "^8.42.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "tsx": "^3.12.7",
    "typescript": "^5.1.3",
    "vite": "^8.0.9"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
